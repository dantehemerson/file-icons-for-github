{
  "name": "seti-icons-for-github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Show VS Code Seti file icons on GitHub: file listings, trees, file finder, code search, gists, and diffs.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "update:seti": "node scripts/update-seti-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "test:all": "npm run compile && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "happy-dom": "^20.8.3",
    "playwright-core": "1.56.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  }
}